<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Grocery.App.Views.NewProductView"
    Title="Nieuw product">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">

            <Label Text="Nieuw product" FontAttributes="Bold" FontSize="18" />

            <Label Text="Naam" />
            <Entry x:Name="NameEntry" Placeholder="Naam" />

            <Label Text="Stock" />
            <Entry x:Name="StockEntry" Keyboard="Numeric" Placeholder="0" />

            <Label Text="Prijs" />
            <Entry x:Name="PriceEntry" Keyboard="Numeric" Placeholder="0.00" />

            <Label Text="Minimumleeftijd (optioneel)" />
            <Entry x:Name="MinimumAgeEntry" Keyboard="Numeric" Placeholder="Bijv. 18" />

            <Label Text="Houdbaarheid" />
            <DatePicker x:Name="ShelfLifePicker" />

            <Button Text="Maak aan" Clicked="OnCreateClicked" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>